# Hugging Face Inference API Token
# Obtain from https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Model identifier for SmolAgents Inference
HF_MODEL_ID=meta-llama/Llama-3.3-70B-Instruct

# Inference provider ('auto' for Hugging Face default routing, or specific provider like 'together', 'sambanova', 'novita')
HF_PROVIDER=auto

# Application-Level Usage and Cost Guard Settings
MAX_AGENT_REQUESTS_PER_SESSION=20
MAX_OUTPUT_TOKENS=512
MAX_CONTEXT_TOKENS=4000

# Server settings
HOST=0.0.0.0
PORT=8000
